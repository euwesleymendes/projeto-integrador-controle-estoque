  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "fornecedorId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "cnpj",
      "value": "12345678000195"
    },
    {
      "key": "codigoBarras",
      "value": "7891234567895"
    },
    {
      "key": "codigoBarras2",
      "value": "7890000111222"
    }
  ],
  "item": [
    {
      "name": "Status da API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
